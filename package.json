{
  "name": "playwright-aicam",
  "version": "1.0.0",
  "description": "Enterprise End-to-End Automation Framework for AICAM using Playwright TypeScript",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:auth": "playwright test src/tests/auth",
    "test:dashboard": "playwright test src/tests/dashboard",
    "test:smoke": "playwright test --grep \"@Smoke\"",
    "test:regression": "playwright test --grep \"@Regression\"",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:allure": "node scripts/test-allure.js",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "allure:clean": "rimraf allure-results allure-report",
    "clean": "rimraf test-results playwright-report allure-results allure-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing",
    "pom",
    "allure-report",
    "aicam"
  ],
  "author": "Antigravity Testing Kit",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.1",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0",
    "dotenv": "^16.4.7",
    "rimraf": "^6.1.4",
    "typescript": "^5.7.2"
  }
}
